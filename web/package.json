    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
